<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <meta name="theme-color" content="#fafbfd">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_DE">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ site.url }}/images/og.jpg">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  {{ head | safe }}
  <style>{% inlineCss "src/css/style.css" %}</style>
</head>
<body class="{{ bodyClass }}">

<a class="skip" href="#inhalt">Zum Inhalt springen</a>

<header class="hdr" data-hdr>
  <div class="hdr__in">
    <a href="/" class="hdr__logo">
      <img src="/images/logo.png" alt="Auktionen Huber – Startseite" width="247" height="53">
    </a>
    <nav class="hdr__nav" aria-label="Hauptnavigation">
      <a href="/#ueber-uns">Über uns</a>
      <a href="/#leistungen">Leistungen</a>
      <a href="/#qualitaet">Qualität</a>
      <a href="/#kontakt">Kontakt</a>
    </nav>
    {% set suffix = "" %}{% include "lang.njk" %}
    <a href="tel:{{ site.phone }}" class="btn btn--primary btn--sm hdr__tel" aria-label="Anrufen: {{ site.phoneLabel }}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      <span>{{ site.phoneLabel }}</span>
    </a>
    <button class="hdr__burger" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mnav" data-burger><span></span><span></span></button>
  </div>
</header>

<div class="mnav" id="mnav" data-mnav hidden>
  <nav aria-label="Mobile Navigation">
    <a href="/#ueber-uns"><small>01</small>Über uns</a>
    <a href="/#leistungen"><small>02</small>Leistungen</a>
    <a href="/#qualitaet"><small>03</small>Qualität</a>
    <a href="/#kontakt"><small>04</small>Kontakt</a>
  </nav>
  <div class="mnav__foot">
    {% set suffix = "-m" %}{% include "lang.njk" %}
    <a href="tel:{{ site.phone }}">{{ site.phoneLabel }}</a>
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  </div>
</div>

<main id="inhalt">
{{ content | safe }}
</main>

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <a href="/" class="ftr__logo">
        <img src="/images/logo.png" alt="Auktionen Huber – Startseite" width="247" height="53" loading="lazy">
      </a>
      <p class="ftr__claim">Gutachten – Verwertungen – Auktionen</p>
    </div>
    <div class="ftr__bottom">
      <p>© Auktionen Huber · Leopoldstr. 244 · 80807 München</p>
      <nav class="ftr__legal" aria-label="Rechtliches">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
        <a href="https://www.aranes.de">Webdesign by ARANES GmbH &amp; Co. KG</a>
      </nav>
    </div>
  </div>
</footer>

<script>{% inlineJs "src/js/main.js" %}</script>
</body>
</html>
